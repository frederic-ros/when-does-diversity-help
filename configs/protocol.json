{
  "protocol_version": "2.0",
  "description": "Single source of truth for the benchmark. Any change here changes the config hash stored in every run record; runs with a different hash are never mixed by the analysis.",
  "seeds": {
    "base": 42,
    "stride": 17,
    "note": "split s uses root seed base + stride*s; independent child streams (data, split, init, model, strategy) are derived with numpy SeedSequence."
  },
  "classifiers": {
    "lr": {
      "class": "sklearn.linear_model.LogisticRegression",
      "params": {
        "max_iter": 2000
      }
    },
    "rf": {
      "class": "sklearn.ensemble.RandomForestClassifier",
      "params": {
        "n_estimators": 50,
        "n_jobs": 1
      }
    }
  },
  "uncertain_band": {
    "taus": [
      0.05,
      0.1,
      0.2,
      0.3
    ],
    "primary_tau": 0.1,
    "geometry_top_fraction": 0.2,
    "geometry_rounds": [
      0
    ],
    "note": "margin m(x) = p(1)(x) - p(2)(x). Band U_tau = {x in pool : m(x) < tau}; width = |U_tau|/|pool|. Logged at every round. Effective dimension and clusterability of the lowest-margin 20% are logged at geometry_rounds only (costly)."
  },
